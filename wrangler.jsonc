{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abilitywebsite",
  "main": "functions/api/contact.js",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "enquiries@abilityit.co.uk" }
  ]
}
